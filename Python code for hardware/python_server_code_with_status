            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            font-weight: 500;
            color: hsl(var(--muted-foreground));
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }

        .header-actions-wrapper {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .header-actions-wrapper .mobile-tab-btn {
            display: none;
        }

        .badge-status {
            display: flex;
            align-items: center;
            gap: 0.35rem;
            font-size: 0.75rem;
            font-family: 'JetBrains Mono', monospace;
            background-color: hsl(var(--muted));
            border: 1px solid rgba(255, 255, 255, 0.05);
            padding: 0.25rem 0.65rem;
            border-radius: 9999px;
            color: hsl(var(--muted-foreground));
        }

        /* Grid Layout */
        .main-layout {
            max-width: 1400px;
            width: 100%;
            margin: 0 auto;
            padding: 1.5rem;
            display: grid;
            grid-template-columns: 4fr 8fr;
            gap: 1.5rem;
            flex: 1;
        }

        /* Card layout */
        .card {
            background-color: hsl(var(--card));
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: var(--radius);
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
            height: fit-content;
        }

        .card-title {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-family: 'Instrument Serif', Georgia, serif;
            font-size: 1.35rem;
            font-style: italic;
            color: hsl(var(--foreground));
        }

        .card-title svg {
            color: hsl(var(--primary));
        }

        .card-subtitle {
            font-size: 0.75rem;
            color: hsl(var(--muted-foreground));
            margin-top: -0.85rem;
            font-family: 'Inter', sans-serif;
        }

        /* Form Styling */
        .form-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 1rem;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 0.35rem;
        }

        .form-group label {
            font-size: 0.7rem;
            font-weight: 600;
            color: hsl(var(--muted-foreground));
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .form-group input, .form-group select {
            background-color: hsl(var(--background));
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 0.5rem;
            padding: 0.65rem 0.85rem;
            color: hsl(var(--foreground));
            font-family: 'Inter', sans-serif;
            font-size: 0.875rem;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .form-group input:focus, .form-group select:focus {
            outline: none;
            border-color: hsl(var(--primary));
            box-shadow: 0 0 0 2px hsla(var(--primary), 0.2);
        }

        .sms-input-group {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 0.5rem;
        }

        /* Buttons */
        .btn-group {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            margin-top: 0.5rem;
        }

        .btn-tactile {
            background: linear-gradient(180deg, hsl(var(--card)) 0%, hsl(var(--background)) 100%);
            box-shadow:
                inset 0 1px 0 0 rgba(255, 255, 255, 0.05),
                0 1px 3px 0 rgba(0, 0, 0, 0.2),
                0 1px 2px -1px rgba(0, 0, 0, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 9999px;
            padding: 0.65rem 1.25rem;
            color: hsl(var(--foreground));
            font-family: 'Inter', sans-serif;
            font-size: 0.85rem;
            font-weight: 500;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            transition: all 0.15s ease;
            text-decoration: none;
        }

        .btn-tactile:hover {
            box-shadow:
                inset 0 1px 0 0 rgba(255, 255, 255, 0.08),
                0 2px 8px 0 rgba(0, 0, 0, 0.25),
                0 1px 2px -1px rgba(0, 0, 0, 0.15);
            transform: translateY(-1px);
        }

        .btn-tactile:active {
            transform: translateY(0) scale(0.98);
            box-shadow: inset 0 2px 4px 0 rgba(0, 0, 0, 0.3);
        }

        .btn-tactile:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none !important;
            box-shadow: none !important;
        }

        .btn-tactile.primary {
            background: hsl(var(--primary));
            color: #fff;
            border-color: hsla(var(--primary), 0.2);
        }

        .btn-tactile.primary:hover {
            background: hsl(var(--primary-hover));
        }

        .btn-tactile.warning {
            background: linear-gradient(180deg, #d97706 0%, #b45309 100%);
            border-color: rgba(217, 119, 6, 0.2);
            color: #fff;
        }

        .btn-tactile.warning:hover {
            background: #f59e0b;
        }

        .btn-tactile.danger {
            background: linear-gradient(180deg, #dc2626 0%, #991b1b 100%);
            color: #fff;
            border-color: rgba(220, 38, 38, 0.2);
        }

        .btn-tactile.danger:hover {
            background: #ef4444;
        }

        /* File panel section */
        .files-control-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            padding-bottom: 1rem;
        }

        .search-container {
            position: relative;
            flex: 1;
            min-width: 240px;
        }

        .search-container input {
            width: 100%;
            background-color: hsl(var(--background));
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 9999px;
            padding: 0.55rem 1rem 0.55rem 2.25rem;
            color: hsl(var(--foreground));
            font-family: 'Inter', sans-serif;
            font-size: 0.85rem;
            transition: border-color 0.2s ease;
        }

        .search-container input:focus {
            outline: none;
            border-color: hsl(var(--primary));
        }

        .search-icon {
            position: absolute;
            left: 0.75rem;
            top: 50%;
            transform: translateY(-50%);
            color: hsl(var(--muted-foreground));
            pointer-events: none;
        }

        .bulk-actions-group {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        /* Custom Checkbox */
        .checkbox-container {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            cursor: pointer;
            font-size: 0.8rem;
            color: hsl(var(--muted-foreground));
            user-select: none;
        }

        .checkbox-container input {
            display: none;
        }

        .custom-checkbox {
            width: 1.1rem;
            height: 1.1rem;
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 0.25rem;
            background-color: hsl(var(--background));
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
        }

        .checkbox-container input:checked + .custom-checkbox {
            background-color: hsl(var(--primary));
            border-color: hsl(var(--primary));
        }

        .checkbox-container input:checked + .custom-checkbox::after {
            content: '';
            width: 4px;
            height: 8px;
            border: solid white;
            border-width: 0 2px 2px 0;
            transform: rotate(45deg);
            margin-bottom: 2px;
        }

        /* Table styling */
        .table-wrapper {
            overflow-x: auto;
            margin-top: 0.5rem;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.875rem;
        }

        th {
            text-align: left;
            padding: 0.75rem 1.0rem;
            color: hsl(var(--muted-foreground));
            font-weight: 500;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        td {
            padding: 0.75rem 1.0rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.03);
            vertical-align: middle;
        }

        .file-row {
            transition: background-color 0.15s ease, opacity 0.2s ease;
        }

        .file-row:hover {
            background-color: rgba(255, 255, 255, 0.015);
        }

        .file-row.dimmed {
            opacity: 0.6;
        }

        .filename {
            font-family: 'JetBrains Mono', monospace;
            font-weight: 500;
            color: hsl(var(--foreground));
            word-break: break-all;
        }

        .badge {
            display: inline-block;
            padding: 0.2rem 0.5rem;
            border-radius: 0.25rem;
            font-size: 0.65rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }

        .badge-new {
            background-color: hsla(var(--primary), 0.1);
            color: hsl(var(--primary));
            border: 1px solid hsla(var(--primary), 0.2);
        }

        .badge-downloaded {
            background-color: rgba(255, 255, 255, 0.05);
            color: hsl(var(--muted-foreground));
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .actions-cell {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn-icon {
            width: 2.2rem;
            height: 2.2rem;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 9999px;
            background-color: hsl(var(--background));
            border: 1px solid rgba(255, 255, 255, 0.05);
            color: hsl(var(--muted-foreground));
            cursor: pointer;
            transition: all 0.2s ease;
            text-decoration: none;
        }

        .btn-icon:hover {
            color: hsl(var(--foreground));
            background-color: hsl(var(--muted));
            border-color: rgba(255, 255, 255, 0.1);
        }

        .btn-icon.primary:hover {
            color: #fff;
            background-color: hsl(var(--primary));
            border-color: hsl(var(--primary));
        }

        .btn-icon.danger:hover {
            color: #fff;
            background-color: #ef4444;
            border-color: #ef4444;
        }

        /* Toast and Modals */
        #toast {
            position: fixed;
            bottom: 1.5rem;
            right: 1.5rem;
            background-color: hsl(var(--card));
            border: 1px solid hsl(var(--primary));
            color: hsl(var(--foreground));
            padding: 0.75rem 1.25rem;
            border-radius: 9999px;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            font-size: 0.85rem;
            font-weight: 500;
            transform: translateY(100px);
            opacity: 0;
            transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s;
            z-index: 1000;
        }

        #toast.show {
            transform: translateY(0);
            opacity: 1;
        }

        .modal {
            position: fixed;
            inset: 0;
            background-color: rgba(0,0,0,0.85);
            backdrop-filter: blur(5px);
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
            z-index: 999;
        }

        .modal.show {
            opacity: 1;
            pointer-events: auto;
        }

        .modal-content {
            background-color: hsl(var(--card));
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: var(--radius);
            padding: 2rem;
            width: 90%;
            max-width: 450px;
            text-align: center;
            box-shadow: 0 20px 50px rgba(0,0,0,0.6);
        }

        .modal-title {
            font-family: 'Instrument Serif', Georgia, serif;
            font-size: 1.5rem;
            font-style: italic;
            margin-bottom: 0.5rem;
        }

        .progress-container {
            width: 100%;
            background-color: hsl(var(--background));
            height: 6px;
            border-radius: 999px;
            overflow: hidden;
            margin: 1.5rem 0 0.75rem;
            border: 1px solid rgba(255, 255, 255, 0.03);
        }

        .progress-bar {
            height: 100%;
            background-color: hsl(var(--primary));
            width: 0%;
            transition: width 0.15s ease;
        }

        .progress-text {
            font-size: 0.8rem;
            color: hsl(var(--muted-foreground));
            font-family: 'JetBrains Mono', monospace;
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 3rem 1rem;
            color: hsl(var(--muted-foreground));
        }

        .empty-state svg {
            color: hsla(var(--primary), 0.2);
            margin-bottom: 1rem;
            display: block;
            margin-left: auto;
            margin-right: auto;
        }

        /* Responsive Grid System matching Whisper design */
        @media (max-width: 1024px) {
            .main-layout {
                grid-template-columns: 1fr;
                padding: 1rem;
            }
            
            .logo {
                display: flex;
                margin-bottom: 0.25rem;
            }
            
            .header-container {
                height: auto;
                padding: 0.75rem 1rem;
                width: 100%;
                display: flex;
                flex-direction: column;
                align-items: flex-start;
                gap: 0.75rem;
            }
            
            .header-actions-wrapper {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 0.5rem 0.75rem;
                width: 100%;
            }
            
            .header-actions-wrapper .mobile-tab-btn {
                display: flex;
                align-items: center;
                justify-content: center;
                background-color: rgba(255, 255, 255, 0.03);
                border: 1px solid rgba(255, 255, 255, 0.05);
                color: hsl(var(--muted-foreground));
                padding: 0.5rem 1rem;
                border-radius: 9999px;
                font-family: 'JetBrains Mono', monospace;
                font-size: 0.75rem;
                font-weight: 500;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                cursor: pointer;
                transition: all 0.2s ease;
                outline: none;
                width: 100%;
            }
            
            .header-actions-wrapper .mobile-tab-btn.active {
                background-color: hsl(var(--foreground));
                color: hsl(var(--background));
                border-color: hsl(var(--foreground));
                font-weight: 600;
            }
            
            .badge-status {
                width: 100%;
                justify-content: center;
                height: 100%;
                padding: 0.5rem 1rem;
            }
            
            .tab-content {
                display: none;
            }
            
            .tab-content.active {
                display: flex !important;
            }
        }

        @media (min-width: 1025px) {
            .tab-content {
                display: flex !important;
            }
        }

        @media (max-width: 640px) {
            .header-container {
                padding: 0 1rem;
            }
            .logo h1 {
                font-size: 1.25rem;
            }
            .header-container {
                padding: 0.75rem 1rem;
            }
            
            /* Hide columns on small screens for optimal fit */
            th:nth-child(3), td:nth-child(3) { /* Size */
                display: none;
            }
            th:nth-child(4), td:nth-child(4) { /* Status */
                display: none;
            }
        }
    </style>
</head>
<body>
    <header>
        <div class="header-container">
            <div class="logo">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 3.58 1 8a7 7 0 0 1-9 10Z"/><path d="M9 22v-4h4"/></svg>
                <div class="logo-title">
                    <span class="italic">Forest Ear</span>
                    <span class="sub">Data Mule</span>
                </div>
            </div>
            <div class="header-actions-wrapper">
                <div class="badge-status" data-val="{{ sd_pct }}% SD" title="SD Disk Usage">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><line x1="9" x2="9" y1="3" y2="9"/><line x1="15" x2="15" y1="3" y2="9"/><line x1="3" x2="9" y1="9" y2="9"/><line x1="15" x2="21" y1="9" y2="9"/></svg>
                    <span>Disk: {{ sd_pct }}%</span>
                </div>
                <button id="hubBtn" class="mobile-tab-btn active" onclick="switchTab('hub')">Control Hub</button>
                <div class="badge-status" data-val="{{ bat_pct }}% Bat" title="Mule Battery Level">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="16" height="10" rx="2" ry="2"/><line x1="22" y1="11" x2="22" y2="13"/></svg>
                    <span>Battery: {{ bat_pct }}%</span>
                </div>
                <button id="recordingsBtn" class="mobile-tab-btn" onclick="switchTab('recordings')">Recordings</button>
            </div>
        </div>
    </header>

    <div class="main-layout">
        <!-- Control Hub Column -->
        <aside id="hubTab" class="tab-content active" style="flex-direction: column; gap: 1.5rem;">
            <div class="card">
                <div class="card-title">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                    <span>Control Hub</span>
                </div>
                <div class="card-subtitle">Manage device timers, settings, and network states</div>
                
                <div class="form-grid">
                    <div class="form-group">
                        <label for="durInput">Recording Duration</label>
                        <input type="number" id="durInput" value="{{ config['duration'] }}" min="1">
                    </div>
                    <div class="form-group">
                        <label for="intInput">Recording Pause (Seconds)</label>
                        <input type="number" id="intInput" value="{{ config['pause'] }}" min="0">
                    </div>
                    <div class="form-group">
                        <label for="phoneInput">Telemetry Alert Phone</label>
                        <input type="text" id="phoneInput" value="{{ config['phone'] }}">
                    </div>
                    <div class="form-group">
                        <label for="smsVal">Telemetry Interval</label>
                        <div class="sms-input-group">
                            <input type="number" id="smsVal" value="{{ config['sms_val'] }}" min="1">
                            <select id="smsUnit">
                                <option value="sec" {% if config['sms_unit'] == 'sec' %}selected{% endif %}>sec</option>
                                <option value="min" {% if config['sms_unit'] == 'min' %}selected{% endif %}>min</option>
                                <option value="hr" {% if config['sms_unit'] == 'hr' %}selected{% endif %}>hr</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="btn-group">
                    <button class="btn-tactile primary" onclick="saveSettings()">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                        Apply Configurations
                    </button>
                    <button id="syncBtn" class="btn-tactile" onclick="syncTime()">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        Sync Device Clock
                    </button>
                    <button id="smsBtn" class="btn-tactile warning" onclick="testSMS()">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                        Test Telemetry SMS
                    </button>
                    <button id="shutdownBtn" class="btn-tactile danger" onclick="shutdownServer()">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18.36 6.64a9 9 0 1 1-12.73 0"></path><line x1="12" y1="2" x2="12" y2="12"></line></svg>
                        Sleep Wi-Fi
                    </button>
                </div>
            </div>
        </aside>

        <!-- Recordings Table Column -->
        <main id="recordingsTab" class="tab-content" style="flex-direction: column;">
            <div class="card" style="width: 100%;">
                <div class="card-title">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"></path><circle cx="6" cy="18" r="3"></circle><circle cx="18" cy="16" r="3"></circle></svg>
                    <span>Audio Recordings</span>
                </div>
                <div class="card-subtitle">Browse, download, or delete recorded data files</div>

                <div class="files-control-bar">
