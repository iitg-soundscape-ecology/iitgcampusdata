# -----------------------------------------------------------------------------
# AUTONOMOUS TELEMETRY SMS SCHEDULER
# -----------------------------------------------------------------------------
def sms_scheduler_thread(state):
    print("[SMS] Scheduler background daemon initialized")
    while True:
        sms_val = state.config.get("sms_val", 1)
        sms_unit = state.config.get("sms_unit", "hr")
        
        multiplier = 1
        if sms_unit == "sec":
            multiplier = 1
        elif sms_unit == "min":
            multiplier = 60
        elif sms_unit == "hr":
            multiplier = 3600
            
        sms_interval = sms_val * multiplier
        current_time = time.time()
        
        # Only send SMS if the Web server / Wi-Fi is sleeping to match ESP32 logic
        if not state.is_wifi_active:
            if current_time - state.last_sms_time >= sms_interval:
                sd_pct = state.get_sd_percentage()
                bat_pct = state.get_battery_percentage()
                msg = f"Rainforest Monitor Alert:\nSD Card Used: {sd_pct:.1f}%\nBattery Level: {bat_pct}%\nStatus: Active."
                state.send_sms(msg)
                state.last_sms_time = current_time
                
        time.sleep(5)

# -----------------------------------------------------------------------------
# BLE SERVER EXECUTABLE DAEMON
# -----------------------------------------------------------------------------
def run_ble_server(state):
    if not DBUS_SUPPORTED:
        print("[BLE] D-Bus not supported on this platform. Running in mock BLE mode.")
        return
        
    try:
        dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
        bus = dbus.SystemBus()
        
        adapter_path = find_adapter(bus)
        if not adapter_path:
            print("[BLE ERROR] No eligible Bluetooth adapter found with GATT support.")
            return
            
        print(f"[BLE] Exposing BLE server on adapter: {adapter_path}")
        
        service_uuid = "4fafc201-1fb5-459e-8fcc-c5c9c331914b"
        ad = Advertisement(bus, 0, service_uuid)
        
        app = Application(bus)
        service = Service(bus, 0, service_uuid, True)
        app.add_service(service)
        
        char_uuid = "beb5483e-36e1-4688-b7f5-ea07361b26a8"
        char = MuleControlCharacteristic(bus, 0, char_uuid, service, state)
        service.add_characteristic(char)
        
        register_ble_ad(bus, adapter_path, ad)
        register_ble_app(bus, adapter_path, app)
        
        mainloop = GLib.MainLoop()
        print("[BLE] BLE Server running and advertising as 'Forest_Ear_BLE'")
        mainloop.run()
    except Exception as e:
        print("[BLE ERROR] BLE daemon failed to register objects:", e)

# -----------------------------------------------------------------------------
# ENTRYPOINT CONFIGURATION
# -----------------------------------------------------------------------------
if __name__ == "__main__":
    # Start the BLE advertising and GATT server daemon in a background thread
    ble_thread = threading.Thread(target=run_ble_server, args=(server_state,), daemon=True)
    ble_thread.start()
    
    # Start the autonomous telemetry SMS scheduler in a background thread
    sms_thread = threading.Thread(target=sms_scheduler_thread, args=(server_state,), daemon=True)
    sms_thread.start()
    
    # Start with Wi-Fi disabled by default for telemetry and battery saving
    # The user wakes up the system via BLE
    # Set to False initially. If running inside dev environment, we can choose to unblock it first.
    server_state.sleep_wifi()
    
    print("[INFO] Rainforest Data Mule System initialized.")
    print("[INFO] BLE interface active continuously.")
    print("[INFO] Web UI server will be activated upon receiving 'wake' command.")
    
    # Keep the main thread alive (since Flask is now started dynamically upon BLE wake)
    try:
        while True:
            time.sleep(10)
    except KeyboardInterrupt:
        print("[INFO] Stopping Rainforest Data Mule System...")
