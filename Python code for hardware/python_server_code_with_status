if DBUS_SUPPORTED:
    class Advertisement(dbus.service.Object):
        PATH_BASE = '/org/bluez/example/advertisement'

        def __init__(self, bus, index, uuid):
            self.path = self.PATH_BASE + str(index)
            self.bus = bus
            self.uuid = uuid
            dbus.service.Object.__init__(self, bus, self.path)

        def get_properties(self):
            properties = dict()
            properties['Type'] = 'peripheral'
            properties['ServiceUUIDs'] = dbus.Array([self.uuid], signature='s')
            properties['LocalName'] = dbus.String('Forest_Ear_BLE')
            properties['Discoverable'] = dbus.Boolean(True)
            return {LE_ADVERTISEMENT_IFACE: properties}

        @dbus.service.method(DBUS_PROP_IFACE, in_signature='ss', out_signature='v')
        def Get(self, interface, prop):
            if interface != LE_ADVERTISEMENT_IFACE:
                raise dbus.exceptions.DBusException('org.freedesktop.DBus.Error.InvalidArgs')
            properties = self.get_properties()[LE_ADVERTISEMENT_IFACE]
            return properties.get(prop)

        @dbus.service.method(DBUS_PROP_IFACE, in_signature='s', out_signature='a{sv}')
        def GetAll(self, interface):
            if interface != LE_ADVERTISEMENT_IFACE:
                raise dbus.exceptions.DBusException('org.freedesktop.DBus.Error.InvalidArgs')
            return self.get_properties()[LE_ADVERTISEMENT_IFACE]

        @dbus.service.method(LE_ADVERTISEMENT_IFACE, in_signature='', out_signature='')
        def Release(self):
            print('%s: Released' % self.path)

    class Application(dbus.service.Object):
        def __init__(self, bus):
            self.path = '/'
            self.services = []
            dbus.service.Object.__init__(self, bus, self.path)

        def add_service(self, service):
            self.services.append(service)

        def get_path(self):
            return dbus.ObjectPath(self.path)

        @dbus.service.method(DBUS_OM_IFACE, in_signature='', out_signature='a{oa{sa{sv}}}')
        def GetManagedObjects(self):
            response = {}
            for service in self.services:
                response[service.get_path()] = service.get_properties()
                chrcs = service.get_characteristics()
                for chrc in chrcs:
                    response[chrc.get_path()] = chrc.get_properties()
            return response

    class Service(dbus.service.Object):
        PATH_BASE = '/org/bluez/example/service'

        def __init__(self, bus, index, uuid, primary):
            self.path = self.PATH_BASE + str(index)
            self.bus = bus
            self.uuid = uuid
            self.primary = primary
            self.characteristics = []
            dbus.service.Object.__init__(self, bus, self.path)

        def get_properties(self):
            return {
                GATT_SERVICE_IFACE: {
                    'UUID': dbus.String(self.uuid),
                    'Primary': dbus.Boolean(self.primary),
                    'Characteristics': dbus.Array(
                        [c.get_path() for c in self.characteristics],
                        signature='o'
                    )
                }
            }

        def get_path(self):
            return dbus.ObjectPath(self.path)

        def add_characteristic(self, characteristic):
            self.characteristics.append(characteristic)

        def get_characteristics(self):
            return self.characteristics

        @dbus.service.method(DBUS_PROP_IFACE, in_signature='ss', out_signature='v')
        def Get(self, interface, prop):
            if interface != GATT_SERVICE_IFACE:
                raise dbus.exceptions.DBusException('org.freedesktop.DBus.Error.InvalidArgs')
            properties = self.get_properties()[GATT_SERVICE_IFACE]
            return properties.get(prop)

        @dbus.service.method(DBUS_PROP_IFACE, in_signature='s', out_signature='a{sv}')
        def GetAll(self, interface):
            if interface != GATT_SERVICE_IFACE:
                raise dbus.exceptions.DBusException('org.freedesktop.DBus.Error.InvalidArgs')
            return self.get_properties()[GATT_SERVICE_IFACE]

    class Characteristic(dbus.service.Object):
        def __init__(self, bus, index, uuid, flags, service):
            self.path = service.path + '/char' + str(index)
            self.bus = bus
            self.uuid = uuid
            self.flags = flags
            self.service = service
            self.value = []
            self.notifying = False
            dbus.service.Object.__init__(self, bus, self.path)

        def get_properties(self):
            return {
                GATT_CHRC_IFACE: {
                    'Service': dbus.ObjectPath(self.service.get_path()),
                    'UUID': dbus.String(self.uuid),
                    'Flags': dbus.Array(self.flags, signature='s'),
                    'Notifying': dbus.Boolean(self.notifying)
                }
            }

        def get_path(self):
            return dbus.ObjectPath(self.path)

        @dbus.service.method(DBUS_PROP_IFACE, in_signature='ss', out_signature='v')
        def Get(self, interface, prop):
            if interface != GATT_CHRC_IFACE:
                raise dbus.exceptions.DBusException('org.freedesktop.DBus.Error.InvalidArgs')
            properties = self.get_properties()[GATT_CHRC_IFACE]
            return properties.get(prop)

        @dbus.service.method(DBUS_PROP_IFACE, in_signature='s', out_signature='a{sv}')
        def GetAll(self, interface):
            if interface != GATT_CHRC_IFACE:
                raise dbus.exceptions.DBusException('org.freedesktop.DBus.Error.InvalidArgs')
            return self.get_properties()[GATT_CHRC_IFACE]

        @dbus.service.method(GATT_CHRC_IFACE, in_signature='a{sv}', out_signature='ay')
        def ReadValue(self, options):
            return self.read_value(options)

        @dbus.service.method(GATT_CHRC_IFACE, in_signature='aya{sv}', out_signature='')
        def WriteValue(self, value, options):
            self.write_value(value, options)

        @dbus.service.method(GATT_CHRC_IFACE, in_signature='', out_signature='')
        def StartNotify(self):
            self.start_notify()

        @dbus.service.method(GATT_CHRC_IFACE, in_signature='', out_signature='')
        def StopNotify(self):
            self.stop_notify()

        def read_value(self, options):
            return dbus.Array(self.value, signature='y')

        def write_value(self, value, options):
            pass

        def start_notify(self):
            self.notifying = True

        def stop_notify(self):
            self.notifying = False

        @dbus.service.signal(DBUS_PROP_IFACE, signature='sa{sv}as')
        def PropertiesChanged(self, interface, changed_properties, invalidated_properties):
            pass

    class MuleControlCharacteristic(Characteristic):
        def __init__(self, bus, index, uuid, service, server_state):
            Characteristic.__init__(self, bus, index, uuid, ['read', 'write', 'notify'], service)
            self.server_state = server_state
            self.server_state.ble_characteristic = self
            self.update_value("Send 'WAKE' to start Wi-Fi, 'SLEEP' to stop Wi-Fi")

        def update_value(self, new_val):
            if not new_val.endswith('\n'):
                new_val += '\n'
            self.value = [dbus.Byte(b) for b in new_val.encode('utf-8')]
            if self.notifying:
                # Emit PropertiesChanged D-Bus signal to notify clients
                self.PropertiesChanged(GATT_CHRC_IFACE, {'Value': dbus.Array(self.value, signature='y')}, [])

        def read_value(self, options):
            val_str = "".join([chr(int(b)) for b in self.value])
            print(f"[BLE] Read request received, returning: {val_str}")
            return dbus.Array(self.value, signature='y')

        def write_value(self, value, options):
            try:
                command = "".join([chr(int(b)) for b in value]).strip()
                print(f"[BLE] Write request received: {command}")
                cmd_lower = command.lower()
                if cmd_lower in ["wake", "start", "wifi_on", "on"]:
                    self.update_value("Waking up Wi-Fi...")
                    # Wake up Wi-Fi in a background thread to return instantly
                    threading.Thread(target=self.server_state.wake_wifi, args=(self,), daemon=True).start()
                elif cmd_lower in ["sleep", "off", "wifi_off", "sleep_wifi", "stop", "shutdown"]:
                    self.update_value("Putting Wi-Fi to sleep...")
                    # Sleep Wi-Fi in a background thread to return instantly
                    threading.Thread(target=self.server_state.sleep_wifi, daemon=True).start()
                elif cmd_lower in ["status", "record", "recording", "rec"]:
                    status_msg = self.server_state.get_recording_status_summary()
                    self.update_value(status_msg)
                else:
                    self.update_value(f"Unknown cmd: '{command}'. Available: WAKE, SLEEP, STATUS")
            except Exception as e:
                print("[BLE] Error processing write:", e)

