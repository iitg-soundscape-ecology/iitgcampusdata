def find_adapter(bus):
    remote_om = dbus.Interface(bus.get_object(BLUEZ_SERVICE_NAME, '/'), DBUS_OM_IFACE)
    objects = remote_om.GetManagedObjects()
    for path, interfaces in objects.items():
        if LE_ADVERTISING_MANAGER_IFACE in interfaces and GATT_MANAGER_IFACE in interfaces:
            return path
    return None

def register_ble_app(bus, adapter_path, app):
    service_provider = dbus.Interface(bus.get_object(BLUEZ_SERVICE_NAME, adapter_path), GATT_MANAGER_IFACE)
    service_provider.RegisterApplication(app.get_path(), {},
        reply_handler=lambda: print('[BLE] GATT application registered successfully'),
        error_handler=lambda err: print('[BLE] Failed to register GATT application: ' + str(err)))

def register_ble_ad(bus, adapter_path, ad):
    ad_provider = dbus.Interface(bus.get_object(BLUEZ_SERVICE_NAME, adapter_path), LE_ADVERTISING_MANAGER_IFACE)
    ad_provider.RegisterAdvertisement(ad.path, {},
        reply_handler=lambda: print('[BLE] Advertisement registered successfully'),
        error_handler=lambda err: print('[BLE] Failed to register advertisement: ' + str(err)))

