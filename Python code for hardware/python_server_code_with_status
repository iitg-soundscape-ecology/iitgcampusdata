class DataMuleServerState:
    def __init__(self):
        # Paths configured matching soundscape_ngrok_final.py
        self.config_path = "/home/rpi/Desktop/Working code/data_mule_config.json"
        
        self.is_wifi_active = False
        self.flask_started = False
        self.last_sms_time = time.time()
        self.target_ssid = TARGET_SSID
        self.load_config()

    @property
    def output_dir(self):
        primary_dir = "/media/rpi/ForestEar/Audio_Recordings"
        fallback_dir = "/home/rpi/Desktop/Working code/audio_recordings_temp"
        if os.path.exists("/media/rpi/ForestEar"):
            target_dir = primary_dir
        else:
            target_dir = fallback_dir
        os.makedirs(target_dir, exist_ok=True)
        return target_dir

    def load_config(self):
        os.makedirs(os.path.dirname(self.config_path), exist_ok=True)
        os.makedirs(self.output_dir, exist_ok=True)
        
        defaults = {
            "duration": 10,
            "pause": 20,
            "phone": "+919876543210",
            "sms_val": 1,
            "sms_unit": "hr",
            "modem_port": "/dev/ttyUSB2",
            "target_ssid": self.target_ssid
        }
        
        if os.path.exists(self.config_path):
            try:
                with open(self.config_path, "r") as f:
                    self.config = json.load(f)
                    for k, v in defaults.items():
                        if k not in self.config:
                            self.config[k] = v
            except Exception as e:
                print("[ERROR] Failed to load config, using defaults:", e)
                self.config = defaults
        else:
            self.config = defaults
            self.save_config(self.config)
        
        self.target_ssid = self.config.get("target_ssid", TARGET_SSID)

    def save_config(self, new_config):
        self.config = new_config
        try:
            with open(self.config_path, "w") as f:
                json.dump(self.config, f, indent=2)
            print("[INFO] Config saved:", self.config)
        except Exception as e:
            print("[ERROR] Failed to save config:", e)

    def get_battery_percentage(self):
        # Check standard Linux power supply configurations if present
        try:
            for ps_path in ["/sys/class/power_supply/BAT0", "/sys/class/power_supply/battery"]:
                if os.path.exists(ps_path):
                    with open(os.path.join(ps_path, "capacity"), "r") as f:
                        return int(f.read().strip())
        except Exception:
            pass
        return 92  # Premium mock battery default

    def get_sd_percentage(self):
        try:
            total, used, free = shutil.disk_usage(self.output_dir)
            return (used / total) * 100.0
        except Exception as e:
            print("[ERROR] Failed to read disk usage:", e)
            return 0.0

    def send_sms(self, message):
        port = self.config.get("modem_port", "/dev/ttyUSB2")
        phone = self.config.get("phone", "+919876543210")
        if not port or port.lower() == "none":
            print(f"[SMS MOCK] To {phone}: {message}")
            return True
            
        try:
            print(f"[SMS] Transmitting to {phone} via modem at {port}...")
            import serial
            ser = serial.Serial(port, baudrate=115200, timeout=5)
            ser.write(b"AT+CMGF=1\r")
            time.sleep(1)
            ser.read_all() # Clear buffer
            
            cmd = f'AT+CMGS="{phone}"\r'
            ser.write(cmd.encode())
            time.sleep(1)
            
            ser.write(f"{message}\r\n".encode())
            time.sleep(1)
            ser.write(bytes([26])) # Ctrl+Z
            time.sleep(3)
            
            response = ser.read_all().decode(errors="ignore")
            print("[SMS] Modem response:", response)
            ser.close()
            return "OK" in response or "+CMGS:" in response
        except Exception as e:
            print("[SMS ERROR] Failed to send SMS:", e)
            return False

    def wake_wifi(self, characteristic=None):
        if self.is_wifi_active:
            if characteristic:
                ip = self.get_ip_address()
                characteristic.update_value(f"IP: http://{ip}")
            return
            
        print("[WAKE] Enabling Wi-Fi adapter...")
        try:
            # rfkill unblocks hardware RF switches
            subprocess.run(["sudo", "rfkill", "unblock", "wifi"], check=True)
            subprocess.run(["sudo", "ip", "link", "set", "wlan0", "up"], check=False)
        except Exception as e:
            print("[WAKE] Error executing system WiFi enable:", e)
            
        # Allow interface initialization
        time.sleep(2)
        
        # Trigger connection specifically to the configured SSID
        print(f"[WAKE] Attempting connection to SSID '{self.target_ssid}'...")
        try:
            # First, check if NetworkManager is running and use nmcli to connect.
            # Disconnect from any automatically connected network first to ensure we connect ONLY to target SSID.
            subprocess.run(["sudo", "nmcli", "device", "disconnect", "wlan0"], capture_output=True, timeout=5)
            
            nmcli_res = subprocess.run(["sudo", "nmcli", "connection", "up", self.target_ssid], capture_output=True, text=True, timeout=15)
            if nmcli_res.returncode == 0:
                print(f"[WAKE] Connected to SSID '{self.target_ssid}' via NetworkManager.")
            else:
                print(f"[WAKE] nmcli connection failed: {nmcli_res.stderr.strip()}. Trying wpa_cli fallback...")
                raise Exception("nmcli failed")
        except Exception:
            # Fallback to wpa_cli if NetworkManager is not available or connection failed
            try:
                # Disconnect from any current wpa_supplicant association
                subprocess.run(["sudo", "wpa_cli", "-i", "wlan0", "disconnect"], capture_output=True, timeout=5)
                
                wpa_res = subprocess.run(["sudo", "wpa_cli", "-i", "wlan0", "list_networks"], capture_output=True, text=True, timeout=5)
                if wpa_res.returncode == 0:
                    net_id = None
                    for line in wpa_res.stdout.splitlines():
                        if self.target_ssid in line:
                            net_id = line.split()[0]
                            break
                    if net_id:
                        # select_network disables other networks so wpa_supplicant won't connect to them
                        subprocess.run(["sudo", "wpa_cli", "-i", "wlan0", "select_network", net_id], check=False)
                        subprocess.run(["sudo", "wpa_cli", "-i", "wlan0", "enable_network", net_id], check=False)
                        subprocess.run(["sudo", "wpa_cli", "-i", "wlan0", "reassociate"], check=False)
                        print(f"[WAKE] Selected network {net_id} ({self.target_ssid}) via wpa_cli.")
                    else:
                        print(f"[WAKE] {self.target_ssid} network not found in wpa_supplicant saved networks list.")
                else:
                    print("[WAKE] wpa_cli failed to list networks.")
            except Exception as e:
                print(f"[WAKE] wpa_cli fallback error: {e}")
            
        # Poll for IP assignment
        ip = None
        for i in range(15):
            time.sleep(1)
            ip = self.get_ip_address()
            if ip and ip != "127.0.0.1":
                break
                
        if not ip or ip == "127.0.0.1":
            ip_val = "Wi-Fi wake timed out. Check networks."
        else:
            self.is_wifi_active = True
            ip_val = f"IP: http://{ip}"
            print(f"[WAKE] Wi-Fi Active. URL: {ip_val}")
            
        # Start Flask web server in a background thread if not already running
        if not self.flask_started:
            print("[WAKE] Starting Flask Web Server...")
            def run_flask():
                try:
                    app.run(host="0.0.0.0", port=80, debug=False, use_reloader=False)
                except Exception as e:
                    print("[ERROR] Web server failed to bind to port 80 (likely requires sudo / root privileges):", e)
                    print("[INFO] Attempting fallback to port 8080...")
                    app.run(host="0.0.0.0", port=8080, debug=False, use_reloader=False)
            
            threading.Thread(target=run_flask, daemon=True).start()
            self.flask_started = True
            
        if characteristic:
            characteristic.update_value(ip_val)

    def sleep_wifi(self):
        print("[SLEEP] Disabling Wi-Fi adapter...")
        
        # Send notification feedback to the BLE terminal
        if hasattr(self, "ble_characteristic") and self.ble_characteristic:
            try:
                self.ble_characteristic.update_value("Wi-Fi has been turned off / Server is sleeping.")
                print("[SLEEP] Updated BLE characteristic notification.")
            except Exception as e:
                print("[SLEEP] Failed to update BLE characteristic:", e)
                
        try:
            subprocess.run(["sudo", "rfkill", "block", "wifi"], check=True)
            self.is_wifi_active = False
        except Exception as e:
            print("[SLEEP] Error executing system WiFi block:", e)

    def get_ip_address(self):
        try:
            ips = subprocess.check_output(["hostname", "-I"]).decode().strip().split()
            for ip in ips:
                if not ip.startswith("127."):
                    return ip
        except Exception:
            pass
        return None

    def get_recording_status_summary(self):
        # 1. Check if the recorder service is active
        service_status = "inactive"
        try:
            res = subprocess.run(["systemctl", "is-active", "soundscape_recorder.service"], 
                                 capture_output=True, text=True, timeout=2)
            service_status = res.stdout.strip()
        except Exception as e:
            service_status = f"error ({e})"

        # 2. Check if currently recording (is 'sox' process running?)
        is_recording = "Idle"
        try:
            res = subprocess.run(["pgrep", "sox"], capture_output=True, text=True)
            if res.returncode == 0:
                is_recording = "Recording"
        except Exception:
            pass

        # 3. Read total files and last recording from CSV log or directory
        total_files = 0
        try:
            if os.path.exists(self.output_dir):
                total_files = len([f for f in os.listdir(self.output_dir) if f.endswith(".wav")])
        except Exception:
            pass

        last_log = "No log found"
        csv_path = os.path.join(self.output_dir, "sound_log.csv")
        if os.path.exists(csv_path):
            try:
                with open(csv_path, "r") as f:
                    lines = f.readlines()
                    if len(lines) > 1:
                        # Grab the last line (most recent log)
                        last_line = lines[-1].strip()
                        parts = last_line.split(",")
                        if len(parts) >= 4:
                            ts, audio_file, cls, conf = parts[0], parts[1], parts[2], parts[3]
                            last_log = f"{audio_file} -> {cls} ({conf}) at {ts}"
                        else:
                            last_log = last_line
            except Exception as e:
                last_log = f"Err: {e}"

        return (
            f"[REC STATUS]\n"
            f"Service: {service_status} ({is_recording})\n"
            f"Total WAVs: {total_files}\n"
            f"Last: {last_log}"
        )

