        // Client-side ZIP generation (uncompressed/store method)
        function createZip(files) {
            const crcTable = [];
            for (let n = 0; n < 256; n++) {
                let c = n;
                for (let k = 0; k < 8; k++) {
                    c = ((c & 1) ? (0xEDB88320 ^ (c >>> 1)) : (c >>> 1));
                }
                crcTable[n] = c;
            }

            function crc32(buf) {
                const u8 = new Uint8Array(buf);
                let crc = 0 ^ (-1);
                for (let i = 0; i < u8.length; i++) {
                    crc = (crc >>> 8) ^ crcTable[(crc ^ u8[i]) & 0xFF];
                }
                return (crc ^ (-1)) >>> 0;
            }

            let parts = [];
            let offsets = [];
            let currentOffset = 0;

            // 1. Local File Headers
            files.forEach((f) => {
                const nameBytes = new TextEncoder().encode(f.name.replace('/', ''));
                const fileData = new Uint8Array(f.buffer);
                const fileCrc = crc32(f.buffer);
                const fileLen = fileData.length;

                const lfh = new Uint8Array(30 + nameBytes.length);
                
                // Signature: PK\3\4
                lfh[0] = 0x50; lfh[1] = 0x4b; lfh[2] = 0x03; lfh[3] = 0x04;
                // Version needed to extract: 10
                lfh[4] = 10; lfh[5] = 0;
                // General purpose bit flag: 0
                lfh[6] = 0; lfh[7] = 0;
                // Compression method: 0 (Store)
                lfh[8] = 0; lfh[9] = 0;
                // Last mod file time/date: 0
                lfh[10] = 0; lfh[11] = 0;
                lfh[12] = 0; lfh[13] = 0;
                
                // CRC-32
                lfh[14] = fileCrc & 0xff;
                lfh[15] = (fileCrc >> 8) & 0xff;
                lfh[16] = (fileCrc >> 16) & 0xff;
                lfh[17] = (fileCrc >> 24) & 0xff;

                // Compressed size
                lfh[18] = fileLen & 0xff;
                lfh[19] = (fileLen >> 8) & 0xff;
                lfh[20] = (fileLen >> 16) & 0xff;
                lfh[21] = (fileLen >> 24) & 0xff;

                // Uncompressed size
                lfh[22] = fileLen & 0xff;
                lfh[23] = (fileLen >> 8) & 0xff;
                lfh[24] = (fileLen >> 16) & 0xff;
                lfh[25] = (fileLen >> 24) & 0xff;

                // Filename length
                lfh[26] = nameBytes.length & 0xff;
                lfh[27] = (nameBytes.length >> 8) & 0xff;

                // Extra field length: 0
                lfh[28] = 0; lfh[29] = 0;

                // Filename
                lfh.set(nameBytes, 30);

                offsets.push(currentOffset);
                parts.push(lfh);
                parts.push(fileData);

                currentOffset += lfh.length + fileData.length;
            });

            // 2. Central Directory
            let centralDirectoryOffset = currentOffset;
            let centralDirectorySize = 0;

            files.forEach((f, idx) => {
                const nameBytes = new TextEncoder().encode(f.name.replace('/', ''));
                const fileCrc = crc32(f.buffer);
                const fileLen = f.buffer.byteLength;
                const offset = offsets[idx];

                const cdh = new Uint8Array(46 + nameBytes.length);

                // Signature: PK\1\2
                cdh[0] = 0x50; cdh[1] = 0x4b; cdh[2] = 0x01; cdh[3] = 0x02;
                // Version made by: 20
                cdh[4] = 20; cdh[5] = 0;
                // Version needed to extract: 10
                cdh[6] = 10; cdh[7] = 0;
                // General purpose bit flag: 0
                cdh[8] = 0; cdh[9] = 0;
                // Compression method: 0
                cdh[10] = 0; cdh[11] = 0;
                // Last mod file time/date: 0
                cdh[12] = 0; cdh[13] = 0;
                cdh[14] = 0; cdh[15] = 0;

                // CRC-32
                cdh[16] = fileCrc & 0xff;
                cdh[17] = (fileCrc >> 8) & 0xff;
                cdh[18] = (fileCrc >> 16) & 0xff;
                cdh[19] = (fileCrc >> 24) & 0xff;

                // Compressed size
                cdh[20] = fileLen & 0xff;
                cdh[21] = (fileLen >> 8) & 0xff;
                cdh[22] = (fileLen >> 16) & 0xff;
                cdh[23] = (fileLen >> 24) & 0xff;

                // Uncompressed size
                cdh[24] = fileLen & 0xff;
                cdh[25] = (fileLen >> 8) & 0xff;
                cdh[26] = (fileLen >> 16) & 0xff;
                cdh[27] = (fileLen >> 24) & 0xff;

                // Filename length
                cdh[28] = nameBytes.length & 0xff;
                cdh[29] = (nameBytes.length >> 8) & 0xff;

                // Extra field length: 0
                cdh[30] = 0; cdh[31] = 0;
                // File comment length: 0
                cdh[32] = 0; cdh[33] = 0;
                // Disk number start: 0
                cdh[34] = 0; cdh[35] = 0;
                // Internal file attributes: 0
                cdh[36] = 0; cdh[37] = 0;
                // External file attributes: 0
                cdh[38] = 0; cdh[39] = 0; cdh[40] = 0; cdh[41] = 0;

                // Local header offset
                cdh[42] = offset & 0xff;
                cdh[43] = (offset >> 8) & 0xff;
                cdh[44] = (offset >> 16) & 0xff;
                cdh[45] = (offset >> 24) & 0xff;

                // Filename
                cdh.set(nameBytes, 46);

                parts.push(cdh);
                centralDirectorySize += cdh.length;
            });

            // 3. End of Central Directory
            const eocd = new Uint8Array(22);

            // Signature: PK\5\6
            eocd[0] = 0x50; eocd[1] = 0x4b; eocd[2] = 0x05; eocd[3] = 0x06;
            // Disk number: 0
            eocd[4] = 0; eocd[5] = 0;
            // Start disk: 0
            eocd[6] = 0; eocd[7] = 0;
            // Entries on disk:
            eocd[8] = files.length & 0xff;
            eocd[9] = (files.length >> 8) & 0xff;
            // Total entries:
            eocd[10] = files.length & 0xff;
            eocd[11] = (files.length >> 8) & 0xff;
            // Central directory size:
            eocd[12] = centralDirectorySize & 0xff;
            eocd[13] = (centralDirectorySize >> 8) & 0xff;
            eocd[14] = (centralDirectorySize >> 16) & 0xff;
            eocd[15] = (centralDirectorySize >> 24) & 0xff;
            // Central directory offset:
            eocd[16] = centralDirectoryOffset & 0xff;
            eocd[17] = (centralDirectoryOffset >> 8) & 0xff;
            eocd[18] = (centralDirectoryOffset >> 16) & 0xff;
            eocd[19] = (centralDirectoryOffset >> 24) & 0xff;
            // Comment length: 0
            eocd[20] = 0; eocd[21] = 0;

            parts.push(eocd);

            return new Blob(parts, { type: 'application/zip' });
        }

        async function downloadSelected() {
            const checks = document.querySelectorAll('.file-chk:checked');
            if (checks.length === 0) return alert('No files selected!');
            
            showModal('Preparing Downloads', 'Starting download queue...');
            let zipFiles = [];
            
            for (let i = 0; i < checks.length; i++) {
                let fn = checks[i].value;
                let progress = Math.round((i / checks.length) * 100);
                updateModal(progress, `Fetching file ${i + 1} of ${checks.length}: ${fn}`);
                
                try {
                    let res = await fetch('/download?file=' + fn);
                    if (res.ok) {
                        let buf = await res.arrayBuffer();
                        zipFiles.push({ name: fn, buffer: buf });
                        markDownloaded(fn);
                    }
                } catch (e) {
                    console.error('Failed to fetch', fn, e);
                }
                await new Promise(r => setTimeout(r, 50));
            }
            
            updateModal(95, 'Zipping files into ZIP archive...');
            await new Promise(r => setTimeout(r, 100));
            
            try {
                let zipBlob = createZip(zipFiles);
                let url = window.URL.createObjectURL(zipBlob);
                let a = document.createElement('a');
                a.href = url;
                
                let d = new Date();
                let ts = d.getFullYear() + 
                         ('0' + (d.getMonth() + 1)).slice(-2) + 
                         ('0' + d.getDate()).slice(-2) + '_' + 
                         ('0' + d.getHours()).slice(-2) + 
                         ('0' + d.getMinutes()).slice(-2);
                
                a.download = 'Rainforest_Data_' + ts + '.zip';
                document.body.appendChild(a);
                a.click();
                a.remove();
                window.URL.revokeObjectURL(url);
                showToast('Downloaded ' + zipFiles.length + ' files successfully');
            } catch (err) {
                alert('Error creating archive: ' + err.message);
            } finally {
                hideModal();
            }
        }

        async function deleteSelected() {
            const checks = document.querySelectorAll('.file-chk:checked');
            if (checks.length === 0) return alert('No files selected!');
            if (!confirm(`Are you sure you want to permanently delete these ${checks.length} files?`)) return;
            
            showModal('Deleting Files', 'Deleting queue...');
            for (let i = 0; i < checks.length; i++) {
                let fn = checks[i].value;
                let progress = Math.round((i / checks.length) * 100);
                updateModal(progress, `Deleting ${fn}...`);
                
                try {
                    await fetch('/delete?file=' + fn);
                    localStorage.removeItem('dl_' + fn);
                } catch (e) {
                    console.error('Failed to delete', fn, e);
                }
            }
            hideModal();
            window.location.reload();
        }

        async function deleteSingle(fn) {
            if (!confirm('Are you sure you want to delete ' + fn + '?')) return;
            document.getElementById('row_' + fn).style.opacity = '0.4';
            try {
                const res = await fetch('/delete?file=' + fn);
                if (res.ok) {
                    localStorage.removeItem('dl_' + fn);
                    window.location.reload();
                } else {
                    alert('Failed to delete ' + fn);
                    document.getElementById('row_' + fn).style.opacity = '1';
                }
            } catch (e) {
                alert('Network error.');
                document.getElementById('row_' + fn).style.opacity = '1';
            }
        }
    </script>
</body>
