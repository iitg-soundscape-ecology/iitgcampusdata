@app.route("/")
def index():
    files_list = []
    try:
        if os.path.exists(server_state.output_dir):
            for f in os.listdir(server_state.output_dir):
                path = os.path.join(server_state.output_dir, f)
                if os.path.isfile(path) and f.endswith(".wav"):
                    size_kb = os.path.getsize(path) / 1024.0
                    files_list.append({
                        "name": f,
                        "size_kb": round(size_kb, 1)
                    })
    except Exception as e:
        print("[ERROR] Scanning recordings directory failed:", e)
        
    # Sort descending by filename (newer recordings first)
    files_list.sort(key=lambda x: x["name"], reverse=True)
    
    bat_pct = server_state.get_battery_percentage()
    sd_pct = server_state.get_sd_percentage()
    
    return render_template_string(
        DASHBOARD_HTML,
        files=files_list,
        config=server_state.config,
        bat_pct=bat_pct,
        sd_pct=round(sd_pct, 1)
    )

@app.route("/download")
def download_file():
    filename = request.args.get("file")
    if not filename:
        return "Missing file name", 400
        
    filename = os.path.basename(filename)
    filepath = os.path.join(server_state.output_dir, filename)
    
    if os.path.exists(filepath) and os.path.isfile(filepath):
        return send_from_directory(server_state.output_dir, filename, as_attachment=True)
    return "File Not Found", 404

@app.route("/delete")
def delete_file():
    filename = request.args.get("file")
    if not filename:
        return "Missing file name", 400
        
    filename = os.path.basename(filename)
    filepath = os.path.join(server_state.output_dir, filename)
    
    if os.path.exists(filepath) and os.path.isfile(filepath):
        try:
            os.remove(filepath)
            return "Deleted OK"
        except Exception as e:
            print("[FILE ERROR] Failed to delete file:", e)
            return "Delete failed", 500
    return "File Not Found", 404

